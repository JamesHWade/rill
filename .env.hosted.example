# Local PostgreSQL. Use a development-only value without URL-reserved characters.
RILL_POSTGRES_PASSWORD=replace-with-a-local-password

# Auth0 Regular Web Application settings.
OAUTH2_PROXY_CLIENT_ID=replace-with-auth0-client-id
OAUTH2_PROXY_CLIENT_SECRET=replace-with-auth0-client-secret
OAUTH2_PROXY_OIDC_ISSUER_URL=https://your-tenant.us.auth0.com/
OAUTH2_PROXY_REDIRECT_URL=http://127.0.0.1:10000/oauth2/callback

# Generate with: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=replace-with-a-32-byte-base64url-secret

RILL_PUBLIC_PORT=10000
RILL_ACTOR_ID=local-reader
RILL_ENV=development

# Optional Rill integrations.
RILL_CAPTURE_TOKEN=
RILL_AGENT_MODEL=openai
RILL_AGENT_BASE_URL=
RILL_AGENT_POLICY_URL=
RILL_ORIENTATION_ENABLED=false

# Set credentials only for the provider named by RILL_AGENT_MODEL.
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

DEFUDDLE_BACKEND=hosted
DEFUDDLE_API_KEY=
OTEL_SERVICE_NAME=rill
OTEL_RESOURCE_ATTRIBUTES=service.namespace=personal-reader,deployment.environment=development
OTEL_TRACES_EXPORTER=http
OTEL_LOGS_EXPORTER=http
OTEL_METRICS_EXPORTER=none
OTEL_R_SUPPRESS_SCOPES=httr2
OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT=256
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
