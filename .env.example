# Persistence. Leave blank to run with the bundled in-memory demo data.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Reader identity for a single-user deployment.
RILL_ACTOR_ID=reader
RILL_ENV=development

# Ask Rill model and its provider credential.
RILL_AGENT_MODEL=openai
# Custom provider endpoint. Required when Rill cannot resolve one; consent is
# bound to this exact endpoint.
RILL_AGENT_BASE_URL=
OPENAI_API_KEY=

# Make maintained Orientation available. Each Reader must still confirm its
# Data Destination in the app before bounded reading copies are sent.
RILL_ORIENTATION_ENABLED=false

# Required before automatic Orientation can use an external Data Destination.
RILL_AGENT_POLICY_URL=https://provider.example/privacy

# Optional. Enables POST /api/v1/captures for a local browser clipper.
RILL_CAPTURE_TOKEN=replace-with-a-long-random-token

# Use "local" to extract with a locally installed Defuddle CLI instead.
DEFUDDLE_BACKEND=hosted
DEFUDDLE_COMMAND=defuddle

# Optional. Used only by the hosted Defuddle backend.
DEFUDDLE_API_KEY=

# Optional OpenTelemetry export to Logfire. Product events always stay in Postgres.
OTEL_SERVICE_NAME=rill
OTEL_RESOURCE_ATTRIBUTES=service.namespace=personal-reader,deployment.environment=development
OTEL_TRACES_EXPORTER=http
OTEL_LOGS_EXPORTER=http
OTEL_METRICS_EXPORTER=none
# httr2's automatic HTTP spans may include full URLs, so suppress that scope.
OTEL_R_SUPPRESS_SCOPES=httr2
OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT=256
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
OTEL_EXPORTER_OTLP_ENDPOINT=https://logfire-us.pydantic.dev
OTEL_EXPORTER_OTLP_HEADERS=Authorization=your-logfire-write-token
